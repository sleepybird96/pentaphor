"SettingsView.65" = "Undo an entry from the achievement screen or History. Counts and points are recalculated, and linked Perseverance bonuses may change.";
"SettingsView.66" = "Version";
"SettingsView.67" = "Progress stored on your device";
"SettingsView.68" = "Your nickname, settings, quests and history are stored on this device. No separate app account is required. We do not collect your entries through advertising or analytics tools. When you tap iCloud backup, a copy of your current data is saved to the iCloud Drive linked to your Apple Account.";
"SettingsView.69" = "Keeping your data";
"SettingsView.70" = "Use Backup & restore in Settings to manually save to the PENTAPHOR folder in iCloud Drive. Confirm the upload is complete before deleting the app or switching devices. Automatic backups and live syncing are not provided. Deleting the app may remove on-device entries and pre-restore data, but uploaded iCloud backup files can be restored.";
